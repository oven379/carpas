{
  "name": "car-passport-mvp",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "build": "vite build && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs && node scripts/check-seo.mjs",
    "expo:start": "npm --prefix expo run start",
    "expo:android": "npm --prefix expo run android",
    "expo:ios": "npm --prefix expo run ios",
    "build:mobile": "npm --prefix expo run lint",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "verify": "npm run lint && npm run test && npm run build",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "docker:migrate": "docker compose run --rm backend php artisan migrate --force",
    "test:backend": "docker compose run --rm backend php artisan test",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "check:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@al-bani/car-brands": "^1.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.13.2"
  },
  "overrides": {
    "camera-controls": "3.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.0-rc.13",
    "@rolldown/binding-linux-x64-musl": "1.0.0-rc.13",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.15",
    "typescript": "5.6.3",
    "vite": "^8.0.6"
  }
}
